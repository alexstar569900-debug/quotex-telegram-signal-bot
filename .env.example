# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_CHAT_ID=your_admin_chat_id
CHANNEL_ID=-1001234567890

# Quotex API Configuration
QUOTEX_SSID=your_ssid_token_here
QUOTEX_EMAIL=your_email@example.com
QUOTEX_PASSWORD=your_password
QUOTEX_DEMO_MODE=true

# AI Model Configuration
ML_MODEL_PATH=./models/signal_model.pkl
RSI_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
BOLLINGER_PERIOD=20

# Risk Management
MAX_TRADE_AMOUNT=50.0
MIN_WIN_RATE=0.65
MAX_DAILY_TRADES=20
STOP_LOSS_PERCENT=5
TAKE_PROFIT_PERCENT=15

# Database
DATABASE_URL=sqlite:///./bot_database.db

# API Keys
YAHOO_API_KEY=your_key_here

# Server Configuration
API_PORT=8000
API_HOST=0.0.0.0
LOG_LEVEL=INFO